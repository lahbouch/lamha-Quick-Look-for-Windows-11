<Window x:Class="Lamha.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات لمحة"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource PlexArabic}"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource Surface}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,10,24,20">
        <TextBlock Text="عام" Style="{StaticResource Section}" />
        <CheckBox x:Name="StartWithWindows" Content="التشغيل مع بدء Windows" />
        <CheckBox x:Name="Integration" Content="تفعيل التكامل مع مستكشف الملفات (مفتاح المسافة)" />
        <CheckBox x:Name="AutoPreview" Content="تحديث المعاينة تلقائيًا عند تغيير التحديد في المستكشف" />

        <TextBlock Text="نافذة المعاينة" Style="{StaticResource Section}" />
        <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="حجم النافذة" VerticalAlignment="Center" />
            <ComboBox x:Name="Sizing" DockPanel.Dock="Left" Width="190" HorizontalAlignment="Left" Margin="12,0,0,0">
                <ComboBoxItem Content="يتكيف مع المحتوى" />
                <ComboBoxItem Content="كبير دائمًا" />
            </ComboBox>
        </DockPanel>
        <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="التكبير الافتراضي" VerticalAlignment="Center" />
            <ComboBox x:Name="Zoom" DockPanel.Dock="Left" Width="190" HorizontalAlignment="Left" Margin="12,0,0,0">
                <ComboBoxItem Content="ملاءمة العرض" />
                <ComboBoxItem Content="ملاءمة الصفحة" />
                <ComboBoxItem Content="الحجم الفعلي" />
            </ComboBox>
        </DockPanel>
        <CheckBox x:Name="RememberSize" Content="تذكر آخر حجم للنافذة" />

        <TextBlock Text="التشخيص" Style="{StaticResource Section}" />
        <CheckBox x:Name="VerboseLog" Content="تسجيل تفاصيل إضافية" />
        <Button Style="{StaticResource SecondaryButton}" Content="فتح مجلد السجلات" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnOpenLogs" />

        <TextBlock Text="حول التطبيق" Style="{StaticResource Section}" />
        <TextBlock x:Name="About" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" LineHeight="21" />

        <Button Style="{StaticResource PrimaryButton}" Content="حفظ" HorizontalAlignment="Left" MinWidth="90" Margin="0,18,0,0" Click="OnSave" IsDefault="True" />
    </StackPanel>
</Window>
