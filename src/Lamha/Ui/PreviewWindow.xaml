<Window x:Class="Lamha.Ui.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لمحة"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource PlexArabic}"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource Surface}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        MinWidth="440" MinHeight="300"
        UseLayoutRounding="True"
        PreviewKeyDown="OnKey">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Height="48" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="6,0,10,0">
                <TextBlock x:Name="FileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Meta" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="ToolsHost" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />

            <TextBlock x:Name="Status" Grid.Column="2" Margin="10,0" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}" FlowDirection="LeftToRight" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel x:Name="Nav" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="PrevButton" Style="{StaticResource ToolButton}" Content="&#xE76C;" ToolTip="الملف السابق" Click="OnPrevious" />
                    <TextBlock x:Name="Position" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Accent}" FlowDirection="LeftToRight" Margin="4,0" />
                    <Button x:Name="NextButton" Style="{StaticResource ToolButton}" Content="&#xE76B;" ToolTip="الملف التالي" Click="OnNext" />
                </StackPanel>
                <Button Style="{StaticResource ToolButton}" Content="&#xE897;" ToolTip="اختصارات لوحة المفاتيح (F1)" AutomationProperties.Name="اختصارات لوحة المفاتيح" Click="OnHelp" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE838;" ToolTip="فتح المجلد (F)" AutomationProperties.Name="فتح المجلد" Click="OnOpenFolder" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE8E5;" ToolTip="فتح الملف الأصلي (Enter)" AutomationProperties.Name="فتح الملف الأصلي" Click="OnOpenOriginal" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE711;" ToolTip="إغلاق (Esc)" AutomationProperties.Name="إغلاق" Click="OnClose" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="Body" Background="{StaticResource Stage}" MouseDown="OnBodyDoubleClick">
            <ContentPresenter x:Name="Host" />

            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Ellipse Width="34" Height="34" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeDashArray="14 8" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform x:Name="Spin" /></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="جارٍ تحضير المعاينة…" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Visibility="Collapsed">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Margin="0,12,0,14" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Style="{StaticResource SecondaryButton}" Content="فتح الملف الأصلي" HorizontalAlignment="Center" Click="OnOpenOriginal" />
            </StackPanel>

            <StackPanel x:Name="PasswordPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Visibility="Collapsed">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="{StaticResource AccentTan}" HorizontalAlignment="Center" />
                <TextBlock x:Name="PasswordText" Margin="0,12,0,10" TextWrapping="Wrap" TextAlignment="Center" />
                <PasswordBox x:Name="PasswordInput" Height="32" FlowDirection="LeftToRight" KeyDown="OnPasswordKey" Style="{StaticResource PasswordInput}" />
                <Button Style="{StaticResource PrimaryButton}" Content="فتح" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnPasswordSubmit" />
            </StackPanel>

            <Border x:Name="HelpPanel" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="اختصارات لوحة المفاتيح" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                    <TextBlock LineHeight="23">
                        <Run Text="مسافة أو Esc: إغلاق" /><LineBreak />
                        <Run Text="السهم الأيسر أو الأيمن: الملف السابق أو التالي" /><LineBreak />
                        <Run Text="Enter: فتح الملف الأصلي" /><LineBreak />
                        <Run Text="F: فتح المجلد" /><LineBreak />
                        <Run Text="Ctrl+C: نسخ" /><LineBreak />
                        <Run Text=".: ملء الشاشة" /><LineBreak />
                        <Run Text="+ أو -: تكبير أو تصغير" /><LineBreak />
                        <Run Text="0: ملاءمة النافذة، 1: الحجم الفعلي، 2: ملاءمة العرض" /><LineBreak />
                        <Run Text="R: تدوير، Shift+R: تدوير عكسي" /><LineBreak />
                        <Run Text="Page Up أو Page Down: الصفحة أو الورقة السابقة أو التالية" /><LineBreak />
                        <Run Text="Home أو End: أول صفحة أو آخر صفحة" /><LineBreak />
                        <Run Text="Ctrl+F: بحث، F3: النتيجة التالية" /><LineBreak />
                        <Run Text="T: المصغرات، Ctrl+P: طباعة" /><LineBreak />
                        <Run Text="W: التفاف الأسطر" /><LineBreak />
                        <Run Text="P: تشغيل أو إيقاف، J أو L: تقديم أو إرجاع 5 ثوانٍ" /><LineBreak />
                        <Run Text="السهمان لأعلى ولأسفل: مستوى الصوت، M: كتم الصوت" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
