<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\lamha.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>Lamha</AssemblyName>
    <Product>لمحة</Product>
    <Version>1.0.0</Version>
    <Copyright>© 2026</Copyright>
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="Lamha.Tests" />
    <InternalsVisibleTo Include="Lamha.Harness" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\lamha.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

</Project>
